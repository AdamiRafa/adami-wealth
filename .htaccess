# Portal Adami Captal, servido pela HostGator.
# Publicado automaticamente pelo GitHub (.github/publicar-hostgator.sh).

# Nunca servir versão velha: o navegador sempre pergunta ao servidor se o arquivo mudou
# (no-cache). Se não mudou, o servidor responde "304, use o que você tem" sem mandar o
# arquivo de novo; se mudou, manda o novo. Assim o selo de versão do rodapé continua
# confiável e o Hub abre mais rápido. Até a 3.25 era no-store, que baixava tudo a cada
# abertura. As bibliotecas de vendor/ (nome com a versão) e as imagens de img/ têm cache
# longo, nos .htaccess das próprias pastas.
<IfModule mod_headers.c>
  Header set Cache-Control "no-cache, must-revalidate"
  Header unset Expires
</IfModule>
# Sem listagem de pastas (vendor/, comum/, estilo/...).
Options -Indexes
<IfModule mod_expires.c>
  ExpiresActive Off
</IfModule>
# Aplicativo no celular (3.10): o manifesto precisa do tipo certo.
AddType application/manifest+json .webmanifest

# Sempre por https: o login e a sessão do Supabase não podem trafegar sem cadeado.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # Webhook do BTG (09/11/2026): o BTG só aceita endereço no domínio da Adami; webhook/btg.php
  # passa o aviso para a função btg-webhook do Supabase. Ex.: /hub/webhook/btg/rm-reports-nnm
  RewriteRule ^webhook/btg/([a-z0-9][a-z0-9-]{2,79})/?$ webhook/btg.php?servico=$1 [L,QSA]
</IfModule>

# Cabeçalhos de segurança (06/11/2026, varredura de segurança).
# - HSTS: o navegador passa a usar só https neste endereço, mesmo se alguém digitar http.
# - nosniff, Referrer-Policy e Permissions-Policy: o básico recomendado.
# - X-Frame-Options e frame-ancestors: nenhum outro site consegue abrir o Hub dentro de
#   uma moldura para enganar o clique (clickjacking).
# - Content-Security-Policy: o navegador só aceita script do próprio Hub e só conversa
#   com o Supabase (e o Banco Central, para a PTAX). Um código injetado não consegue
#   carregar nada de fora nem mandar dados para outro servidor.
#   Se um módulo novo precisar de outro endereço, ele entra aqui.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=15552000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "same-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://ghxjqmjtmbqzvogwzylo.supabase.co wss://ghxjqmjtmbqzvogwzylo.supabase.co https://olinda.bcb.gov.br; worker-src 'self' blob:; frame-src 'self' blob:; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"
</IfModule>
